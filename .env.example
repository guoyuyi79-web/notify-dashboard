# 每个项目一套（项目 id 大写）
# SCRIPT_URL = 该项目 Apps Script 网页应用 /exec 地址
# PULL_TOKEN = 该项目 config_filter 里的「拉取令牌」

PROJECT_MG18_SCRIPT_URL=https://script.google.com/macros/s/xxxxx/exec
PROJECT_MG18_PULL_TOKEN=change-me-pull-token

# PROJECT_PDF06_SCRIPT_URL=https://script.google.com/macros/s/yyyyy/exec
# PROJECT_PDF06_PULL_TOKEN=another-token